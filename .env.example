# ==========================================
# Solana Memecoin Radar - Configurações (.env)
# ==========================================

# 1. Telegram (Obrigatório para receber alertas)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# trocar as contas (sem @, separadas por vírgula); vazio desliga o recurso
HUNTER_X_POST_ALERTS=
HUNTER_X_POSTS_DAILY_BUDGET=
# enviar esses alertas para outro chat (por padrão vão para o chat principal)
HUNTER_X_POSTS_CHAT_ID=

# 2. Helius & Solana RPC (Recomendado para análise on-chain de risco e holders)
# Obtenha sua chave gratuita em https://helius.dev
HELIUS_API_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

   HUNTER_TELEGRAM_BOT_TOKEN=
   # opcional: receber esses alertas também no chat principal
   HUNTER_X_ALSO_MAIN=false

# 3. Fontes de Descoberta
# Ativa conexão em tempo real WebSocket com Pump.fun via PumpPortal
ENABLE_PUMPPORTAL=true
# Intervalo de varredura periódica no DexScreener (segundos)
POLL_SECONDS=30

# 4. Filtros e Parâmetros de Avaliação
MIN_SCORE=55
MIN_LIQUIDITY_USD=2000
MAX_TOKEN_AGE_HOURS=3

# 5. Proteção Anti-Rugpull & Detecção de Concentração
# Alerta crítico se uma única carteira não-pool possuir % igual ou superior a:
MAX_SINGLE_HOLDER_PCT=20.0
# Alerta se as Top 10 carteiras não-pool possuírem % igual ou superior a:
MAX_TOP10_HOLDERS_PCT=45.0
# Ativar detecção heurística de Sybil / Multi-carteiras compradas pelo mesmo dev:
ENABLE_BUNDLED_DETECTION=true

# 6. Redes Sociais e Diagnóstico
ENABLE_X_SEARCH=true
X_BEARER_TOKEN=

# 7. Persistência
STATE_FILE=alerted_tokens.json
SMART_WALLETS_FILE=smart_wallets.json
SIMULATION_FILE=simulation_state.json

# 8. Simulação de Compras (Paper Trading)
ENABLE_SIMULATION=true
SIM_INITIAL_CAPITAL=20.0
SIM_BUY_AMOUNT=2.0
SIM_STOP_LOSS_PCT=20.0
SIM_TRAILING_STOP_PCT=20.0

